# SMTP Email — para que el formulario de contacto envíe correos reales
# Configura estos valores en las Environment Variables de Vercel.
# Si no se configuran, los mensajes se loguean en consola (modo dev).
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx  (App Password de Gmail)
# SMTP_FROM=tu@gmail.com

# Telegram — reenvío de los mensajes de contacto del formulario al dueño
# TELEGRAM_BOT_TOKEN=9999999999:AAxxxxxxxxxxxx  (token del bot, ej. @jistevbot)
# TELEGRAM_CHAT_ID=123456789                    (chat_id personal donde llegan los avisos)

# Chat embebido — URL pública del puente que corre en tu infra (NAS/Mac).
# El puente vive en bot/ y se lanza con: node --env-file=.env src/index.js
# Configúrala en Vercel Environment Variables como NEXT_PUBLIC_TELEGRAM_API.
# NEXT_PUBLIC_TELEGRAM_API=http://100.110.148.69:8787
